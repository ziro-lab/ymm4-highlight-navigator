<UserControl x:Class="Ymm4HighlightNavigator.Plugin.LearningView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="360" MinHeight="440">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Grid.Row="0" IsEnabled="{Binding CanEdit}" Margin="0,0,0,8">
   <Button x:Name="ChooseFolderButton" Content="教材フォルダーを選ぶ" Command="{Binding ChooseFolderCommand}" Padding="9,5" Margin="0,0,8,5"/>
   <Button Content="動画を追加" Command="{Binding ChooseFilesCommand}" Padding="9,5" Margin="0,0,0,5"/>
  </WrapPanel>
  <StackPanel Grid.Row="1" IsEnabled="{Binding CanEdit}">
   <TextBlock Text="保存済み教材の分類"/>
   <ComboBox ItemsSource="{Binding KnownLabels}" SelectedItem="{Binding SelectedLabel}" DisplayMemberPath="Display" Margin="0,3,0,8" AutomationProperties.Name="教材の分類"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="グループ"/><TextBox Text="{Binding Group,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" AutomationProperties.Name="グループ"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="フィルター名"/><TextBox Text="{Binding FilterName,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" AutomationProperties.Name="フィルター名"/></StackPanel>
   </Grid>
  </StackPanel>
  <TextBlock Grid.Row="2" Text="{Binding InputSummary}" TextWrapping="Wrap" Margin="0,8,0,8"/>
  <WrapPanel Grid.Row="3" Margin="0,0,0,8">
   <Button x:Name="ImportButton" Content="教材を取り込む" Command="{Binding ImportCommand}" Padding="9,5" Margin="0,0,8,5"/>
   <Button x:Name="CreateFilterButton" Content="フィルター候補を作る" Command="{Binding CreateCommand}" Padding="9,5" Margin="0,0,8,5"/>
   <Button Content="中止" Command="{Binding CancelCommand}" Padding="9,5" Margin="0,0,0,5"/>
  </WrapPanel>
  <ListBox Grid.Row="4" x:Name="LearningResults" ItemsSource="{Binding Rows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemTemplate><DataTemplate>
    <StackPanel Margin="2,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Result}"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/></StackPanel>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="5" Margin="0,8,0,0">
   <TextBlock Text="{Binding DraftSummary}" TextWrapping="Wrap"/>
   <TextBlock Text="教材内の候補一致です。狙った切り替わりかは、長尺動画で確認してください。" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,7"/>
   <WrapPanel>
    <Button x:Name="TryFilterButton" Content="長尺動画で試す" Command="{Binding PreviewCommand}" Padding="9,5" Margin="0,0,8,5"/>
    <Button x:Name="SaveFilterButton" Content="保存して使う" Command="{Binding SaveCommand}" Padding="9,5" Margin="0,0,8,5"/>
    <Button Content="前の版に戻す" Command="{Binding RollbackCommand}" Padding="9,5" Margin="0,0,0,5"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="6" Margin="0,5,0,0"><ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress,Mode=OneWay}" Height="4"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</UserControl>
