<UserControl x:Class="Ymm4HighlightNavigator.Plugin.LearningView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="360" MinHeight="440">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Grid.Row="0" IsEnabled="{Binding CanEdit}" Margin="0,0,0,6">
   <Button x:Name="ChooseFolderButton" Content="教材フォルダーを選ぶ" Command="{Binding ChooseFolderCommand}" Padding="7,4" Margin="0,0,6,3"/>
   <Button Content="動画を追加" Command="{Binding ChooseFilesCommand}" Padding="7,4" Margin="0,0,0,3"/>
  </WrapPanel>
  <StackPanel Grid.Row="1" IsEnabled="{Binding CanEdit}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox ItemsSource="{Binding KnownLabels}" SelectedItem="{Binding SelectedLabel}" DisplayMemberPath="Display" AutomationProperties.Name="保存済み教材の分類" ToolTip="既存の分類を選ぶか、新規分類を作成します"/>
    <Button Grid.Column="1" Content="新規分類" Command="{Binding NewClassificationCommand}" Padding="6,2" Margin="6,0,0,0"/>
   </Grid>
   <Grid x:Name="ClassificationInputs" Margin="0,4,0,0" Visibility="{Binding IsNewClassification,Converter={StaticResource BoolVisibility}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,6,0"><TextBlock Text="グループ"/><TextBox Text="{Binding Group,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="グループ"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="フィルター名"/><TextBox Text="{Binding FilterName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="フィルター名"/></StackPanel>
   </Grid>
   <TextBlock Text="{Binding AvailabilityHint}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
  </StackPanel>
  <TextBlock Grid.Row="2" Text="{Binding InputSummary}" TextWrapping="Wrap" Margin="0,5,0,5" FontSize="11"/>
  <StackPanel Grid.Row="3">
   <WrapPanel Margin="0,0,0,4">
    <Button x:Name="ImportButton" Content="教材を取り込む" Command="{Binding ImportCommand}" Padding="7,4" Margin="0,0,6,3"/>
    <Button x:Name="CreateFilterButton" Content="フィルター候補を作る" Command="{Binding CreateCommand}" Padding="7,4" Margin="0,0,6,3"/>
    <Button Content="中止" Command="{Binding CancelCommand}" Padding="6,4" Margin="0,0,0,3"/>
   </WrapPanel>
   <TextBlock Text="{Binding RowsHeading}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RowsHeading}" FontSize="11" Margin="0,0,0,3"/>
  </StackPanel>
  <ListBox Grid.Row="4" x:Name="LearningResults" ItemsSource="{Binding Rows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Result}"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="5" Margin="0,6,0,0">
   <TextBlock Text="{Binding DraftSummary}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding DraftHint}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
   <TextBlock Text="候補一致は正解判定ではありません。狙った切り替わりかは試用で確認してください。" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,5"/>
   <WrapPanel>
    <Button x:Name="TryFilterButton" Content="長尺動画で試す" Command="{Binding PreviewCommand}" Padding="7,4" Margin="0,0,6,3"/>
    <Button x:Name="SaveFilterButton" Content="保存して使う" Command="{Binding SaveCommand}" Padding="7,4" Margin="0,0,6,3"/>
   </WrapPanel>
   <Expander Header="保持中の候補・保存版の操作" FontSize="11">
    <StackPanel Margin="4,3,0,0">
     <TextBlock Text="前の保存版へ戻しても、未保存候補は消えません。破棄だけは候補を削除します。" TextWrapping="Wrap"/>
     <WrapPanel>
      <Button Content="候補を作った分類へ戻る" Command="{Binding RestoreDraftContextCommand}" Padding="5,3" Margin="0,3,6,3"/>
      <Button Content="未保存候補を破棄" Command="{Binding DiscardDraftCommand}" Padding="5,3" Margin="0,3,6,3"/>
      <Button Content="前の保存版に戻す" Command="{Binding RollbackCommand}" Padding="5,3" Margin="0,3,0,3"/>
     </WrapPanel>
    </StackPanel>
   </Expander>
  </StackPanel>
  <StackPanel Grid.Row="6" Margin="0,5,0,0"><ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress,Mode=OneWay}" Height="4"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="64" ToolTip="{Binding Status}"/></StackPanel>
 </Grid>
</UserControl>
