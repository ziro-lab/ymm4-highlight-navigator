<UserControl x:Class="Ymm4HighlightNavigator.Plugin.ViewIntentManagerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="360" MinHeight="420">
 <Grid Margin="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Text="「見たいもの」は、何を探すかのFilter構成です。基本や既存のものを複製して、自分用に育てられます。" TextWrapping="Wrap" Margin="0,0,0,7"/>
  <ListBox x:Name="ViewIntentManagementList" Grid.Row="1" ItemsSource="{Binding ViewIntents}" SelectedItem="{Binding ManagedViewIntent}"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemTemplate><DataTemplate>
    <StackPanel Margin="4,4">
     <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <WrapPanel Grid.Row="2" Margin="0,6,0,4">
   <Button x:Name="DuplicateViewIntentButton" Content="複製" Command="{Binding DuplicateManagedViewIntentCommand}" Padding="7,3" Margin="0,0,6,3"/>
   <Button x:Name="DeleteViewIntentButton" Content="削除" Command="{Binding DeleteManagedViewIntentCommand}" Padding="7,3" Margin="0,0,6,3"/>
  </WrapPanel>
  <Expander Grid.Row="3" Header="名前・分類" IsExpanded="True">
   <StackPanel Margin="4,4,4,2">
    <TextBlock Text="{Binding ManagedViewIntentDescription}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
    <TextBlock Text="名前"/>
    <TextBox x:Name="ManagedViewIntentNameBox" Text="{Binding ManagedViewIntentName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
     IsEnabled="{Binding ManagedViewIntentCanEdit}" AutomationProperties.Name="見たいものの名前"/>
    <TextBlock Text="分類" Margin="0,5,0,0"/>
    <ComboBox x:Name="ManagedViewIntentClassificationBox" IsEditable="True" ItemsSource="{Binding ViewIntentClassificationSuggestions}"
     Text="{Binding ManagedViewIntentClassification,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ManagedViewIntentCanEdit}"
     AutomationProperties.Name="見たいものの分類" ToolTip="例: 動画 > ゲーム。必要なら階層を増やせます。"/>
    <TextBlock Text="例: ゲーム / 動画 > ゲーム。分類は探しやすくするためだけのものです。" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
    <Button x:Name="SaveViewIntentMetadataButton" Content="名前・分類を保存" Command="{Binding SaveManagedViewIntentMetadataCommand}"
     HorizontalAlignment="Left" Padding="7,3" Margin="0,5,0,0"/>
   </StackPanel>
  </Expander>
  <TextBlock Grid.Row="4" Text="{Binding ReviewStatus}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="56" ToolTip="{Binding ReviewStatus}"/>
 </Grid>
</UserControl>
