<UserControl x:Class="Ymm4HighlightNavigator.Plugin.FilterManagerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="320" MinHeight="340">
 <Grid Margin="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Text="保存済みフィルターを整理します。ON/OFFはメイン画面の「フィルター n/m」から変更します。" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <Grid Grid.Row="1" Margin="0,0,0,6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="FilterSearchBox" Text="{Binding FilterSearch,UpdateSourceTrigger=PropertyChanged}"
    AutomationProperties.Name="フィルター名・グループ・使用先で検索" ToolTip="名前・整理グループ・使用先で検索"/>
   <ComboBox x:Name="FilterUsageModeSelector" Grid.Column="1" ItemsSource="{Binding FilterUsageModes}" SelectedItem="{Binding FilterUsageMode}"
    AutomationProperties.Name="フィルター使用状況" MinWidth="82" Margin="6,0,0,0"/>
  </Grid>
  <ListBox Grid.Row="2" x:Name="FilterLibraryList" ItemsSource="{Binding FilterManagementLibrary}" SelectedItem="{Binding ManagedFilterRow}" IsEnabled="{Binding CanConfigure}"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.GroupStyle><GroupStyle>
    <GroupStyle.ContainerStyle><Style TargetType="{x:Type GroupItem}">
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type GroupItem}">
      <Expander IsExpanded="True" Margin="0,3" Header="{Binding Name}"><ItemsPresenter/></Expander>
     </ControlTemplate></Setter.Value></Setter>
    </Style></GroupStyle.ContainerStyle>
   </ListBox.GroupStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <StackPanel Margin="4,4">
     <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
     <TextBlock FontSize="11">
      <Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding UsageSummary}"/>
     </TextBlock>
    </StackPanel>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Expander Grid.Row="3" Header="選択フィルターの詳細" IsExpanded="True" Margin="0,6,0,0">
   <StackPanel Margin="4,4,4,0">
    <TextBlock x:Name="FilterUsageDestinations" Text="{Binding ManagedFilterRow.UsageDestinationsText}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5"/>
    <TextBlock Text="整理グループ"/>
    <TextBox Text="{Binding DisplayGroup,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="表示グループ" IsEnabled="{Binding CanConfigure}"/>
    <TextBlock Text="表示名" Margin="0,3,0,0"/>
    <TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="フィルター表示名" IsEnabled="{Binding CanConfigure}"/>
    <WrapPanel Margin="0,5,0,0">
     <Button Content="表示情報を保存" Command="{Binding SaveFilterPresentationCommand}" Padding="8,3" Margin="0,0,6,3"/>
     <Button x:Name="DeleteManagedFilterButton" Content="未使用フィルターを削除" Command="{Binding DeleteManagedFilterCommand}" Padding="8,3" Margin="0,0,6,3"/>
    </WrapPanel>
    <TextBlock Text="{Binding ManagedFilterRow.DeleteHint}" TextWrapping="Wrap" FontSize="10"/>
   </StackPanel>
  </Expander>
  <TextBlock Grid.Row="4" Text="{Binding ReviewStatus}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="64" ToolTip="{Binding ReviewStatus}"/>
  <Grid Grid.Row="5" Margin="0,5,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ManagerDataStoragePath" Text="{Binding UserDataPath}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding UserDataPath}" VerticalAlignment="Center"/>
   <Button x:Name="ManagerOpenDataFolderButton" Grid.Column="1" Content="保存先を開く" Command="{Binding OpenUserDataFolderCommand}" Padding="6,2" Margin="6,0,0,0"/>
  </Grid>
 </Grid>
</UserControl>
